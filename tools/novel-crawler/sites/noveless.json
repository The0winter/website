{
  "version": 1,
  "id": "noveless",
  "name": "书荒部落",
  "home": "https://noveless.com/",
  "hosts": [
    "noveless.com"
  ],
  "book": {
    "urlPattern": "^/archives/(?<bookId>[0-9]+)/?$",
    "metadata": {
      "title": "#md_handsome_origin > h1",
      "author": {
        "selector": "#md_handsome_origin pre code:contains(作者：)",
        "pattern": "^作者：\\s*(.+)$"
      },
      "category": "#md_handsome_origin pre code:contains(类别：)"
    }
  },
  "spec": {
    "version": 1,
    "kind": "txt",
    "variant": "desktop-noveless-txtzip-v1",
    "title": "${title}",
    "author": "${author}",
    "sourceUrl": "${sourceUrl}",
    "allowedHosts": [
      "noveless.com",
      "d.noveless.com"
    ],
    "delayMs": 1500,
    "timeoutMs": 60000,
    "retries": 1,
    "browser": {
      "headless": true
    },
    "metadata": {
      "title": "#md_handsome_origin > h1",
      "author": {
        "selector": "#md_handsome_origin pre code:contains(作者：)",
        "pattern": "^作者：\\s*(.+)$"
      },
      "category": "#md_handsome_origin pre code:contains(类别：)"
    },
    "resource": {
      "link": "#md_handsome_origin a[href$=\".txt.zip\"]",
      "compression": "zip",
      "password": "noveless.com",
      "encoding": "utf8",
      "preamble": "metadata",
      "headingPattern": "^(第[0-9零〇一二三四五六七八九十百千万两]+[章节卷][^\\r\\n]{0,90}|作品成绩)\\r*$",
      "sectionPattern": "^第[0-9零〇一二三四五六七八九十百千万两]+卷",
      "endBefore": "-----======================================-----\r\n 声明：本书由书荒部落收集整理，文本仅供书友试读"
    }
  }
}
