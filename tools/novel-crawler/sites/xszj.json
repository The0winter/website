{
  "version": 1,
  "id": "xszj",
  "name": "小说集",
  "home": "https://xszj.tw/",
  "hosts": [
    "xszj.tw"
  ],
  "search": {
    "url": "https://xszj.tw/search?keyword=${query}",
    "items": ".novel-info",
    "title": "h2 > a.novel-title",
    "author": ".novel-tags > a[href^='/author/']",
    "link": "h2 > a.novel-title",
    "maxPages": 1
  },
  "book": {
    "urlPattern": "^/book/(?<bookId>[0-9]+)$",
    "metadata": {
      "category": ".detail-info a.tag",
      "title": "h1.detail-title",
      "author": {
        "selector": ".detail-author > a[href^='/author/']",
        "pattern": "^作者[：:]\\s*(.+)$"
      },
      "status": ".detail-status"
    }
  },
  "spec": {
    "version": 1,
    "kind": "html",
    "variant": "desktop-xszj-v3",
    "identityNormalization": "chinese-simplified",
    "title": "${title}",
    "author": "${author}",
    "sourceUrl": "${sourceUrl}",
    "allowedHosts": [
      "xszj.tw"
    ],
    "delayMs": 1200,
    "timeoutMs": 25000,
    "retries": 1,
    "browser": {
      "headless": true
    },
    "metadata": {
      "category": ".detail-info a.tag",
      "title": "h1.detail-title",
      "author": {
        "selector": ".detail-author > a[href^='/author/']",
        "pattern": "^作者[：:]\\s*(.+)$"
      },
      "status": ".detail-status"
    },
    "catalog": {
      "url": "https://xszj.tw/book/${bookId}/catalog/1",
      "links": ".chapter-grid > a[href^='/book/${bookId}/chapter-']",
      "titlePattern": "^(?:第[0-9]+章\\s+(?=第[0-9]+章))?(.+)$",
      "next": "a:contains('下一頁'):first"
    },
    "chapter": {
      "title": {
        "selector": "h1.reading-title",
        "pattern": "^(?:第[0-9]+章\\s+(?=第[0-9]+章))?(.+)$"
      },
      "content": "#reading-body",
      "remove": [
        "script",
        "style",
        "iframe"
      ],
      "removeText": [
        "(?:^|\\n)[\\t 　]*小說集為廣大書友們提供好看的網路小說全文免費線上閱讀，如果您喜歡本站，請分享給更多的書友們！\\s*如果您覺得《[^《》\\n]{1,200}》小說很精彩的話，請貼上以下網址分享給您的好友，謝謝支援！\\s*（ 本書網址：https://xszj\\.tw/book/[0-9]+ ）\\s*$",
        "(?<=\\(完\\))shocking製作\\s*$"
      ]
    }
  }
}
