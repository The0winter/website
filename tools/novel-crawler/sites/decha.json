{
  "version": 1,
  "id": "decha",
  "name": "新落秋网",
  "home": "https://m.decha.cc/",
  "hosts": ["m.decha.cc"],
  "book": {
    "urlPattern": "^/xbqg/(?<bookId>[0-9]+)/$",
    "metadata": {
      "title": {"selector": "meta[property='og:novel:book_name']", "attribute": "content"},
      "author": {"selector": "meta[property='og:novel:author']", "attribute": "content"},
      "description": {"selector": "meta[property='og:description']", "attribute": "content"},
      "status": {"selector": "meta[property='og:novel:status']", "attribute": "content"}
    }
  },
  "spec": {
    "version": 1,
    "kind": "html",
    "variant": "desktop-decha-v1",
    "title": "${title}",
    "author": "${author}",
    "sourceUrl": "${sourceUrl}",
    "allowedHosts": ["m.decha.cc"],
    "delayMs": 1200,
    "timeoutMs": 25000,
    "retries": 1,
    "browser": {"headless": true},
    "metadata": {
      "title": {"selector": "meta[property='og:novel:book_name']", "attribute": "content"},
      "author": {"selector": "meta[property='og:novel:author']", "attribute": "content"},
      "description": {"selector": "meta[property='og:description']", "attribute": "content"},
      "status": {"selector": "meta[property='og:novel:status']", "attribute": "content"}
    },
    "catalog": {
      "links": "ul.chapter > li > a[href^='/xbqg/${bookId}/'][href$='.html']"
    },
    "chapter": {
      "title": "h1.title",
      "content": "#text",
      "remove": ["script", "style", "iframe"]
    }
  }
}
