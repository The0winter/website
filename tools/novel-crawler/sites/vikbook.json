{
  "version": 1,
  "id": "vikbook",
  "name": "xjpvictor的电子书库",
  "home": "https://www.vikbook.com/",
  "hosts": ["www.vikbook.com"],
  "book": {
    "urlPattern": "^/$",
    "metadata": {"title": "h1.title", "author": "a.red[href*='?author=']"}
  },
  "spec": {
    "version": 1,
    "kind": "html",
    "variant": "desktop-vikbook-v1",
    "title": "${title}",
    "author": "${author}",
    "sourceUrl": "${sourceUrl}",
    "allowedHosts": ["www.vikbook.com"],
    "identityNormalization": "chinese-simplified",
    "delayMs": 1500,
    "timeoutMs": 25000,
    "retries": 1,
    "browser": {"headless": true},
    "metadata": {"title": "h1.title", "author": "a.red[href*='?author=']"},
    "catalog": {"url": "${sourceUrl}&display=menu", "links": "#menu-list > span.page > a[href*='display=fulltext']"},
    "chapter": {
      "title": {"selector": "head > title", "pattern": "^([^|]+)\\s*\\|"},
      "content": "#adsense > main",
      "remove": ["script", "style", "iframe", "ins"]
    }
  }
}
