{
  "version": 1,
  "id": "shudugu",
  "name": "速读谷",
  "home": "https://www.shudugu.org/",
  "hosts": ["www.shudugu.org", "shudugu.org"],
  "search": {
    "url": "https://www.shudugu.org/i/sor.aspx?key=${query}",
    "items": ".container > .item",
    "title": ".itemtxt h3 a",
    "author": {"selector": ".itemtxt a[href^='/zuozhe/']", "pattern": "^作者：[\\s]*(.+)$"},
    "link": ".itemtxt h3 a",
    "next": ".page a:contains('下一页')",
    "maxPages": 8
  },
  "book": {
    "urlPattern": "^/(?<bookId>[0-9]+)/$",
    "metadata": {
      "category": ".itemtxt > h1 + p > span:nth-child(2)",
      "status": ".itemtxt > h1 + p > span:first-child",
      "description": ".container > .des:has(p)",
      "title": "h1 > a",
      "author": {"selector": ".itemtxt a[href^='/zuozhe/']", "pattern": "^作者：[\\s]*(.+)$"}
    }
  },
  "spec": {
    "version": 1,
    "kind": "html",
    "variant": "desktop-shudugu-v7",
    "title": "${title}",
    "author": "${author}",
    "sourceUrl": "${sourceUrl}",
    "allowedHosts": ["www.shudugu.org", "shudugu.org"],
    "delayMs": 2000,
    "retries": 0,
    "timeoutMs": 15000,
    "metadata": {
      "category": ".itemtxt > h1 + p > span:nth-child(2)",
      "status": ".itemtxt > h1 + p > span:first-child",
      "description": ".container > .des:has(p)",
      "title": "h1 > a",
      "author": {"selector": ".itemtxt a[href^='/zuozhe/']", "pattern": "^作者：[\\s]*(.+)$"}
    },
    "catalog": {"links": "#list > ul > li > a", "next": "#pages > a.gr:contains('下一页')", "maxPages": 30},
    "chapter": {
      "title": {"selector": "h1", "pattern": ">\\s*(.+)$"},
      "content": ".con",
      "remove": ["script", "style"],
      "removeText": ["(?:^|[\\r\\n])[^\\S\\r\\n]*[:：]+[^\\S\\r\\n]*(?=[\\r\\n]|$)", "(?:^|[\\r\\n])[^\\S\\r\\n]*本章节来源于(?=[?？.。…·°A-Za-z0-9]*[?？])[?？.。…·°A-Za-z0-9]{1,40}[^\\S\\r\\n]*(?=[\\r\\n]|$)", "(?:^|[\\r\\n])[^\\S\\r\\n]*(?:解闷好[，,][^\\S\\r\\n]*)?(?=[?？.。A-Za-z0-9]*[?？])[?？.。A-Za-z0-9]{3,100}(?:随时看[^\\S\\r\\n]*)?全手打无错站[^\\S\\r\\n]*(?=[\\r\\n]|$)"],
      "next": "a:contains('下一页')",
      "maxPages": 10
    }
  }
}
