[Unit]
Description=Test1 legacy Next frontend
After=network.target test1-api.service
Wants=test1-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=test1-web
Group=test1-web
WorkingDirectory=/srv/test1/current/web-next
Environment=NODE_ENV=production
EnvironmentFile=/etc/test1/web.env
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node --max-old-space-size=640 node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/test1/current/web-next/.next-candidate/cache
UMask=0027
MemoryHigh=768M
MemoryMax=1024M
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
