APP_ENV=production
MONGO_URI=mongodb://test1_api:REPLACE_PASSWORD@127.0.0.1:27017/test1?replicaSet=test1-rs&authSource=test1
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
INTERNAL_API_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
IMPORT_SECRET=replace-with-another-random-secret-at-least-32-characters
MONITOR_SECRET=replace-with-a-dedicated-monitor-secret-at-least-32-characters
ALLOWED_ORIGINS=https://candidate.example.test
HOST=127.0.0.1
PORT=5000
TRUST_PROXY=loopback
WRITE_MODE=readonly
EXTERNAL_SERVICES=disabled
MAIL_MODE=capture

# Optional dedicated public book covers. Omit or leave mongo for legacy storage.
COVER_STORAGE=mongo
COVER_R2_BUCKET=book-covers
COVER_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
COVER_R2_ACCESS_KEY_ID=replace-with-cover-bucket-access-key
COVER_R2_SECRET_ACCESS_KEY=replace-with-cover-bucket-secret
COVER_PUBLIC_BASE_URL=https://img.example.test
