[Unit]
Description=Delete R2 covers after seven days without references
After=network-online.target test1-api.service
Wants=network-online.target
ConditionPathExists=/srv/test1/current/infra/clean-unused-covers.mjs

[Service]
Type=oneshot
User=test1-api
Group=test1-api
WorkingDirectory=/srv/test1/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/test1/api.env
ExecStart=/usr/bin/flock -n /var/lib/test1-cover-cleanup/run.lock /opt/node-v22.23.2-linux-x64/bin/node infra/clean-unused-covers.mjs --apply
StateDirectory=test1-cover-cleanup
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TimeoutStartSec=15min
