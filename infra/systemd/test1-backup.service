[Unit]
Description=Test1 full replica set archive
After=test1-mongo.service

[Service]
Type=oneshot
User=test1-backup
Group=test1-backup
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node /srv/test1/current/infra/backup.mjs /etc/test1/backup.json
StateDirectory=test1-backup
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=95min
TimeoutStopSec=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
