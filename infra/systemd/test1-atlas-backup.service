[Unit]
Description=Verified Atlas document backup to private R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=test1-api
Group=test1-api
WorkingDirectory=/srv/test1/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/test1/api.env
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node infra/atlas-data.mjs backup --directory=/var/lib/test1-atlas-backup
StateDirectory=test1-atlas-backup
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=15min
MemoryMax=384M
